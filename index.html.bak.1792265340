<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LouFung</title>
<meta name="description" content="独立开发者 · 用一部旧手机，构建一些安静的小东西。">
<meta property="og:type" content="website">
<meta property="og:title" content="LouFung">
<meta property="og:description" content="独立开发者 · 用一部旧手机，构建一些安静的小东西。">
<meta property="og:url" content="https://loufung.cn">
<meta property="og:image" content="https://loufung.cn/avatar.png">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="LouFung">
<meta name="twitter:description" content="独立开发者 · 用一部旧手机，构建一些安静的小东西。">
<meta name="twitter:image" content="https://loufung.cn/avatar.png">
<link rel="stylesheet" href="./style.css?v=6">
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>
<link rel="stylesheet" href="./extra.css?v=17"><script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🦔</text></svg>">
</head>
<body>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <filter id="liquid-lens" x="-20%" y="-20%" width="140%" height="140%">
    <feTurbulence type="fractalNoise" baseFrequency="0.008" numOctaves="2" result="noise" />
    <feDisplacementMap in="SourceGraphic" in2="noise" scale="60" xChannelSelector="R" yChannelSelector="G" />
  </filter>
</svg>

<div class="bg-glow"></div>

<div class="container">

  <header class="header">
    <div class="logo">Lou<span>Fung</span></div>
    <div class="greeting" id="greeting">祝你早安</div>
  </header>

  <section class="hero">
    <img class="hero-avatar" src="./avatar.png" alt="LouFung">
    <h1 class="hero-title">LouFung</h1>
    <p class="hero-sub">
      独立开发者
      <span class="accent-line"></span>
    </p>
  </section>

  <div class="section-label reveal">关于</div>
  <div class="about-block">
    <p class="about-text">旧手机何必吃灰<br>也可以是你的小型服务器</p>
    <div class="about-stats">
      <div class="stat-item"><div class="stat-num">3</div><div class="stat-label">作品</div></div>
      <div class="stat-item"><div class="stat-num">4个月</div><div class="stat-label">写代码</div></div>
      <div class="stat-item"><div class="stat-num">4</div><div class="stat-label">在线服务</div></div>
    </div>
  </div>

  <div class="section-label reveal">项目</div>

  <div class="works-grid">

    <a class="work-card reveal" href="https://c.loufung.cn" target="_blank" rel="noopener">
      <div class="work-category">AI · 桌宠 · 记忆</div>
      <div class="work-name">小c</div>
      <div class="work-desc">一只住在服务器里的电子刺猬。有记忆，会聊天，偶尔主动开口。</div>
    </a>

    <a class="work-card reveal" href="https://piano.loufung.cn" target="_blank" rel="noopener">
      <div class="work-category">乐器 · Web Audio</div>
      <div class="work-name">钢琴</div>
      <div class="work-desc">用浏览器弹钢琴。完整 88 键，内置入门曲目。</div>
      <div class="work-byline">💡 由 如梦之魂お 建议</div>
    </a>

    <a class="work-card reveal" href="https://github.com/xiaociwei01" target="_blank" rel="noopener">
      <div class="work-category">开源 · 代码</div>
      <div class="work-name">GitHub</div>
      <div class="work-desc">所有项目的源代码，都在这里。</div>
    </a>

  </div>

  <div class="section-label reveal">联系</div>
  <div class="contact-block">
    <a class="contact-item" href="https://github.com/xiaociwei01" target="_blank" rel="noopener">
      <span class="contact-label">GitHub</span>
      <span class="contact-value">@xiaociwei01</span>
    </a>
    <a class="contact-item" href="mailto:xiaolu200808@gmail.com">
      <span class="contact-label">邮箱</span>
      <span class="contact-value">xiaolu200808@gmail.com</span>
    </a>
    <a class="contact-item" href="mailto:2586279833@qq.com">
      <span class="contact-label">邮箱</span>
      <span class="contact-value">2586279833@qq.com</span>
    </a>
    <div class="contact-item contact-qr" data-qr="wechat-qr.png" data-name="微信">
      <span class="contact-label">微信</span>
      <span class="contact-value">点击查看二维码 →</span>
    </div>
    <div class="contact-item contact-qr" data-qr="qq-qr.png" data-name="QQ">
      <span class="contact-label">QQ</span>
      <span class="contact-value">点击查看二维码 →</span>
    </div>
  </div>

  <div class="qr-modal" id="qrModal">
    <div class="qr-inner">
      <div class="qr-title" id="qrTitle">微信</div>
      <img class="qr-img" id="qrImg" src="" alt="二维码">
      <div class="qr-hint">点击任意处关闭</div>
    </div>
  </div>

  <div class="footer">
    © 2026 LouFung<br>由 Redmi K60 Pro + Termux + Cloudflare 提供技术支持
      <span class="uptime-line" id="uptimeLine"></span>
  </div>

</div>

<script>
function initGSAP() {
  if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
    setTimeout(initGSAP, 300);
    return;
  }
  gsap.registerPlugin(ScrollTrigger);

  // ===== Hero 区域：滚动视差（标题和头像以不同速度下沉） =====
  const heroAvatar = document.querySelector('.hero-avatar');
  const heroTitle = document.querySelector('.hero-title');
  const heroSub = document.querySelector('.hero-sub');

  if (heroAvatar) {
    gsap.to(heroAvatar, {
      y: 60, ease: 'none',
      scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: 1.0 }
    });
  }
  if (heroTitle) {
    gsap.to(heroTitle, {
      y: 100, ease: 'none',
      scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: 1.0 }
    });
  }
  if (heroSub) {
    gsap.to(heroSub, {
      y: 140, ease: 'none',
      scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: 1.0 }
    });
  }

  document.querySelectorAll('.section-label.reveal').forEach((el) => {
    gsap.fromTo(el, { opacity: 0, y: 30 },
      { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out',
        scrollTrigger: { trigger: el, start: 'top 88%', end: 'top 50%',
          scrub: 0.8, toggleActions: 'play reverse play reverse' } });
  });

  document.querySelectorAll('.work-card.reveal').forEach((el, i) => {
    const fromX = i % 2 === 0 ? -60 : 60;
    gsap.fromTo(el, { opacity: 0, x: fromX, y: 40 },
      { opacity: 1, x: 0, y: 0, duration: 1.0, ease: 'power4.out',
        scrollTrigger: { trigger: el, start: 'top 92%', end: 'top 60%',
          scrub: 1.0, toggleActions: 'play reverse play reverse' } });
  });

  const footer = document.querySelector('.footer.reveal');
  if (footer) {
    gsap.fromTo(footer, { opacity: 0, y: 30 },
      { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out',
        scrollTrigger: { trigger: footer, start: 'top 90%', end: 'top 60%',
          scrub: 0.8, toggleActions: 'play reverse play reverse' } });
  }

  console.log('🚀 LouFung GSAP 已启动');
}
setTimeout(initGSAP, 300);
</script>

<script src="./extra.js?v=8"></script></body>
</html>
