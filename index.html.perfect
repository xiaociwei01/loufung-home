<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LouFung</title>
<link rel="stylesheet" href="./style.css?v=6">
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>
<link rel="stylesheet" href="./extra.css?v=18">
</head>
<body>
<div class="container">
<header class="header">
<div class="header-top">
<div class="logo">Lou<span>Fung</span></div>
<div class="greeting" id="greeting">祝你早安</div>
</div>
<div class="header-bottom">
<div class="notice-text" id="noticeText">加载公告中…</div>
</div>
</header>
<section class="hero">
<img class="hero-avatar" src="./avatar.png" alt="LouFung">
<h1 class="hero-title">LouFung</h1>
<p class="hero-sub">独立开发者<span class="accent-line"></span></p>
</section>
<div class="section-label reveal">关于</div>
<div class="about-block"><p class="about-text" id="userAbout"></p></div>
<div class="section-label reveal">项目</div>
<div class="works-grid" id="worksGrid"></div>
<div class="section-label reveal">联系</div>
<div class="contact-block">
<a class="contact-item" href="https://github.com/xiaociwei01" target="_blank"><span class="contact-label">GitHub</span><span class="contact-value">@xiaociwei01</span></a>
<a class="contact-item" href="mailto:xiaolu200808@gmail.com"><span class="contact-label">邮箱</span><span class="contact-value">xiaolu200808@gmail.com</span></a>
<a class="contact-item" href="mailto:2586279833@qq.com"><span class="contact-label">邮箱</span><span class="contact-value">2586279833@qq.com</span></a>
<div class="contact-item contact-qr" data-qr="wechat-qr.png" data-name="微信"><span class="contact-label">微信</span><span class="contact-value">点击查看二维码 →</span></div>
<div class="contact-item contact-qr" data-qr="qq-qr.png" data-name="QQ"><span class="contact-label">QQ</span><span class="contact-value">点击查看二维码 →</span></div>
</div>
<div class="qr-modal" id="qrModal">
<div class="qr-inner">
<div class="qr-title" id="qrTitle">微信</div>
<img class="qr-img" id="qrImg" src="" alt="二维码">
<div class="qr-hint">点击任意处关闭</div>
</div>
</div>
<div class="footer">© 2026 LouFung<br>由 Redmi K60 Pro + Termux + Cloudflare 提供技术支持<span class="uptime-line" id="uptimeLine"></span></div>
</div>
<script>
function initGSAP(){
if(typeof gsap==='undefined'||typeof ScrollTrigger==='undefined'){setTimeout(initGSAP,300);return;}
gsap.registerPlugin(ScrollTrigger);
const a=document.querySelector('.hero-avatar'),t=document.querySelector('.hero-title'),s=document.querySelector('.hero-sub');
const st={trigger:'.hero',start:'top top',end:'bottom top',scrub:1.0};
if(a)gsap.to(a,{y:60,ease:'none',scrollTrigger:st});
if(t)gsap.to(t,{y:100,ease:'none',scrollTrigger:st});
if(s)gsap.to(s,{y:140,ease:'none',scrollTrigger:st});
document.querySelectorAll('.section-label.reveal').forEach(function(el){
gsap.fromTo(el,{opacity:0,y:30},{opacity:1,y:0,duration:0.8,ease:'power3.out',scrollTrigger:{trigger:el,start:'top 88%',end:'top 50%',scrub:0.8,toggleActions:'play reverse play reverse'}});
});
}
setTimeout(initGSAP, 300);
</script>
<script src="./extra.js?v=10"></script>
</body>
</html>
